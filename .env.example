# ==============================================================================
# DeepExtract — Personalized RAG Assistant Environment Configuration
# ==============================================================================

# Application runtime
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration
# ------------------------------------------------------------------------------
# Option A (Local standalone with SQLite vector fallback):
# DATABASE_URL=sqlite+aiosqlite:///agentic_rag.db
#
# Option B (Production / Render / Supabase / Neon PostgreSQL with pgvector):
# DATABASE_URL=postgres://rag_user:password@dpg-xxx.oregon-postgres.render.com:5432/agentic_rag?sslmode=require
#
# Option C (Local PostgreSQL components without DATABASE_URL):
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PORT_FORWARD=5432
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=agentic_rag

# Authentication & Security
# ------------------------------------------------------------------------------
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-with-at-least-32-random-characters-for-jwt-signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Embeddings (Sentence Transformers — Local Offline Execution)
# ------------------------------------------------------------------------------
# Provider: sentence_transformers (offline CPU/GPU execution) or openai / fake
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=384

# LLM (Groq / OpenAI)
# ------------------------------------------------------------------------------
# Provider: groq or openai / fake
# Recommended models: llama-3.3-70b-versatile, qwen/qwen3.8-27b, openai/gpt-oss-120b
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your-groq-api-key-here

# Retrieval & Chunking Settings
# ------------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.2
RETRIEVAL_MAX_CONTEXT_CHARS=12000
AGENT_MAX_RETRIEVAL_RETRIES=1
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=25

# Model Context Protocol (MCP) Server
# ------------------------------------------------------------------------------
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_PATH=/mcp
MCP_ISSUER_URL=http://localhost:8000
MCP_RESOURCE_SERVER_URL=http://localhost:8001/mcp

# Google Drive Connector (Optional)
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_MCP_URL=https://drivemcp.googleapis.com/mcp/v1
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_QUOTA_PROJECT=
GOOGLE_DRIVE_INCLUDE_SUBFOLDERS=true
GOOGLE_DRIVE_MAX_FILES=100
